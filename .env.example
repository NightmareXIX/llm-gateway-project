# Copy to .env and fill in. Every variable without a default is required —
# the app refuses to start and names the missing one.
# Mirrors app/config.py::Settings exactly.

# dev | test | prod
ENV=dev

# Postgres, async driver. Must be postgresql+asyncpg://
# 127.0.0.1, not localhost: on Windows the latter resolves to ::1 first and the
# first connection to Docker's published port stalls ~20s before falling back.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@127.0.0.1:5432/gateway

# Set true ONLY when DATABASE_URL points at Supabase's *transaction* pooler
# (port 6543). That pooler gives each transaction a different upstream
# connection, which breaks asyncpg's prepared-statement cache outright —
# DuplicatePreparedStatementError under any concurrency, not a slow degradation.
# Leave false for a direct connection or the session pooler (port 5432).
DB_DISABLE_PREPARED_STATEMENTS=false

# Redis. Read since Phase 2 Step 2 — the circuit breaker's state lives here, so
# every instance skips the same dead provider. The gateway degrades rather than
# fails when it is unreachable (ADR-010), but it is no longer decorative.
# Treat the URL as a credential: it carries a password on any managed host, and
# nothing in the app ever logs it.
REDIS_URL=redis://localhost:6379/0

# Supabase project URL; JWKS is fetched from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# The project must use asymmetric JWT signing keys (ES256/RS256), not the legacy
# shared secret — the gateway rejects HS256 tokens outright.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Reject sessions whose token doesn't assert a confirmed email address.
# Leave true. It only exists as a kill switch in case Supabase reshapes the
# user_metadata.email_verified claim and a missing claim starts locking everyone
# out — flipping an env var beats an emergency redeploy.
REQUIRE_VERIFIED_EMAIL=true

# The three provider credentials. All required, even though Gemini and OpenRouter
# are `enabled: false` in config/providers.yaml until Phase 2 Step 6 — same reason
# REDIS_URL was required through Phase 1. A variable that appears the day a feature
# is switched on breaks the deploy that switches it on.
#
# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
# Google AI Studio — https://aistudio.google.com/apikey
# Quota is per Google Cloud *project*, not per key: a second key adds nothing.
GEMINI_API_KEY=replace_me
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace_me

# D11's kill switch: reorder `auto`'s candidates by measured latency. Leave true.
# Off falls back to config declaration order, which is what a cold process does
# anyway. It exists so the ranking can be switched off in one deploy if it
# misbehaves while the router itself is the thing under debug.
ROUTING_LATENCY_RANKING=true

# Fernet key encrypting every `provider_keys.encrypted_key` at rest — the BYOK
# credentials users paste into Settings. Validated at boot: a malformed value
# kills the process naming this variable rather than failing at the first add.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSING OR ROTATING IT makes every stored user key unreadable. Nothing crashes
# — the resolver logs one error per row and falls back to the shared pool — but
# those keys are gone and each user has to re-add theirs. There is no rotation
# path built (ADR-035 names MultiFernet as the seam). Back it up with the
# database, not separately from it.
ENCRYPTION_KEY=replace_me_with_a_generated_fernet_key

# Phase 3 D15: reserve budget before every attempt, fail closed if Redis can't
# confirm one is there. Leave true. Off is the escape hatch for a Redis outage
# that would otherwise refuse every request — the gateway falls back to Phase
# 2's reactive failover on a real 429, and /readyz stops failing on Redis.
QUOTA_ENFORCEMENT=true

# D16: fraction of every published provider limit held back before the
# tracker sees it, absorbing a fixed-window's up-to-2x boundary overshoot.
QUOTA_HEADROOM_FRACTION=0.1

# D5/D19: serve identical, deterministic requests from the exact-match cache
# instead of calling a provider. Leave true; off makes every request a
# cache BYPASS, which is useful only when debugging response correctness.
CACHE_EXACT_ENABLED=true

# D20: enforce the gateway's own per-user sliding-window limit, independent of
# every upstream provider limit. Leave true; off removes the gateway's only
# protection against one caller draining the shared free-tier pool.
RATE_LIMIT_ENABLED=true

# Phase 4 D23: which ObjectStore backs POST /v1/files. `supabase` in every
# deployed environment; `local` for a dev box without Storage configured;
# `memory` is what the test suite uses. `local`/`memory` need none of the
# three settings below.
FILES_STORAGE_BACKEND=supabase
FILES_LOCAL_DIR=.files
FILES_BUCKET=uploads

# Bypasses row-level security on the whole Supabase project — required when
# FILES_STORAGE_BACKEND=supabase, used for exactly one thing (object read/
# write on FILES_BUCKET), never logged. Dashboard -> Project Settings -> API
# -> service_role. Not the anon key.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Hard cap on one upload, enforced while streaming (a Content-Length header is
# a claim, not a guarantee).
FILE_MAX_BYTES=10000000

# Master switch for the perception lane (file/image understanding). Off, a
# file_ref on a turn fails loudly instead of being resolved — the same
# escape-hatch shape as the other switches above, for when the lane itself is
# what's under debug.
PERCEPTION_ENABLED=true

# Skip the Gemini extraction tier entirely; every extraction goes local (OCR /
# PDF text layer). For the demo that proves the feature survives Gemini being
# switched off, without revoking a key.
PERCEPTION_LOCAL_ONLY=false

# Gate on the local tier's Tesseract OCR path. Detected at startup, never
# assumed present — the binary is a system dependency (Dockerfile), routinely
# absent on a developer's machine. Off (or binary missing): a PDF's text layer
# still reads; an image falls to a clear error instead of a stack trace.
PERCEPTION_LOCAL_OCR_ENABLED=true

# Cap on pages rasterized and OCR'd per document. An unbounded OCR of a long
# scan is minutes of CPU on a request that has to return.
PERCEPTION_OCR_MAX_PAGES=10

# Phase 7 D49: GET /metrics, Prometheus text format. Off returns 404 rather
# than 403 — an endpoint that is switched off should not advertise itself.
METRICS_ENABLED=true

# Bearer token the scrape must present. Empty means the endpoint is open, which
# is fine locally and is not fine on Render, where there is no private network
# to put a scrape target on. No label on this endpoint carries a user id, an
# email or a conversation id, so what this guards is operational shape.
METRICS_TOKEN=
