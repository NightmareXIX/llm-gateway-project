# Copy to .env and fill in. Every variable without a default is required —
# the app refuses to start and names the missing one.
# Mirrors app/config.py::Settings exactly.

# dev | test | prod
ENV=dev

# Postgres, async driver. Must be postgresql+asyncpg://
# 127.0.0.1, not localhost: on Windows the latter resolves to ::1 first and the
# first connection to Docker's published port stalls ~20s before falling back.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@127.0.0.1:5432/gateway

# Set true ONLY when DATABASE_URL points at Supabase's *transaction* pooler
# (port 6543). That pooler gives each transaction a different upstream
# connection, which breaks asyncpg's prepared-statement cache outright —
# DuplicatePreparedStatementError under any concurrency, not a slow degradation.
# Leave false for a direct connection or the session pooler (port 5432).
DB_DISABLE_PREPARED_STATEMENTS=false

# Redis. Unused in Phase 1, still required so the config surface never shifts.
REDIS_URL=redis://localhost:6379/0

# Supabase project URL; JWKS is fetched from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# The project must use asymmetric JWT signing keys (ES256/RS256), not the legacy
# shared secret — the gateway rejects HS256 tokens outright.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Reject sessions whose token doesn't assert a confirmed email address.
# Leave true. It only exists as a kill switch in case Supabase reshapes the
# user_metadata.email_verified claim and a missing claim starts locking everyone
# out — flipping an env var beats an emergency redeploy.
REQUIRE_VERIFIED_EMAIL=true

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Fernet key for encrypting BYOK provider credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_me_with_a_generated_fernet_key
