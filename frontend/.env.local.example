# Copy to .env.local.

# Supabase project — the same project whose JWKS the gateway verifies against.
# Settings → API. The anon key is public by design; it is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the FastAPI gateway lives. Read server-side only, by next.config.ts's
# rewrite — the browser only ever sees /api/gw/* on this origin.
GATEWAY_URL=http://127.0.0.1:8000

# Optional: a pre-confirmed shared account behind the login page's "Try the demo
# account" button. Server-only (no NEXT_PUBLIC_ prefix) — /auth/demo signs in
# with them, so they never reach the browser. Unset both to hide the button.
DEMO_MAIL=
DEMO_PASSWORD=
